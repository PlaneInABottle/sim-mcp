{
  "$comment": "Example MCP configuration for sim-mcp. Copy relevant section to ~/.copilot/mcp-config.json",
  "mcpServers": {
    "sim-mcp": {
      "tools": ["*"],
      "type": "local",
      "command": "npm",
      "args": ["run", "start"],
      "cwd": "/full/path/to/sim-mcp",
      "env": {
        "SIM_API_BASE_URL": "http://localhost:3000",
        "SIM_API_KEY": "${SIM_API_KEY}"
      }
    }
  },
  "_alternative_node_direct": {
    "$comment": "Alternative configuration using direct node execution",
    "sim-mcp": {
      "tools": ["*"],
      "type": "local",
      "command": "node",
      "args": ["/full/path/to/sim-mcp/dist/index.js", "--server"],
      "env": {
        "SIM_API_BASE_URL": "http://localhost:3000",
        "SIM_API_KEY": "${SIM_API_KEY}"
      }
    }
  }
}
