{
  "name": "sim-mcp",
  "version": "0.0.1",
  "description": "MCP server for sim AI workflow platform",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "sim-mcp": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js --server",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": ["mcp", "sim", "workflow", "ai"],
  "engines": {
    "node": ">=20.0.0"
  },
  "author": "sim team",
  "license": "UNLICENSED",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "axios": "^1.7.9",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
