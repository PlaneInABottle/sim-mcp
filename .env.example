# sim-mcp environment reference sample
# Use this file as a reference for variable names and example values.
# npm run start reads environment from your shell or MCP client config.

# Required: Base URL of the sim backend API
SIM_API_BASE_URL=http://localhost:3000

# Required: Your sim API key for authentication
SIM_API_KEY=your-api-key-here

# Optional: Request timeout in milliseconds (default: 30000)
# SIM_TIMEOUT=30000

# Optional: Number of retry attempts for failed requests (default: 3)
# SIM_RETRIES=3

# Optional: Log level (debug, info, warn, error) (default: info)
# LOG_LEVEL=info
